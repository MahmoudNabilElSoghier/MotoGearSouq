# ==========================================
# MotoGearSouq — Production Environment Variables
# ==========================================
# Copy this file to .env.production (or configure in Render & Vercel dashboards).

# --- Database (Neon Serverless Postgres) ---
# Pooled connection string (for app runtime / Prisma client queries)
DATABASE_URL="postgresql://user:password@ep-xyz.us-east-1.aws.neon.tech/neondb?sslmode=require&pool_timeout=10"

# Direct connection string (required for migrations / prisma db push / seed)
DIRECT_URL="postgresql://user:password@ep-xyz-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# --- Authentication (JWT RS256) ---
# Generate using: openssl genrsa -out jwt_private.key 2048 && openssl rsa -in jwt_private.key -pubout -out jwt_public.key
# Note: In Render environment variables, replace newlines with \n or base64 encode.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# --- Admin API Key (Dual auth fallback for scripts & CI) ---
ADMIN_API_KEY="mgs_admin_secure_key_change_me_in_production"

# --- URLs & CORS ---
# Frontend URL (Vercel deployment URL, e.g., https://motogearsouq.com)
FRONTEND_URL="https://motogearsouq.com"

# Backend API URL for Web client (Render URL + /api, e.g., https://motogearsouq-api.onrender.com/api)
NEXT_PUBLIC_API_URL="https://motogearsouq-api.onrender.com/api"

# CORS origins allowed by NestJS API (comma-separated)
CORS_ORIGINS="https://motogearsouq.com,https://www.motogearsouq.com"

# --- OAuth (Google Sign-In) ---
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="https://motogearsouq-api.onrender.com/api/auth/google/callback"

# --- Email (Resend) ---
RESEND_API_KEY="re_123456789"
EMAIL_FROM="MotoGearSouq <noreply@motogearsouq.com>"

# --- Node Environment ---
NODE_ENV="production"
PORT="4000"
