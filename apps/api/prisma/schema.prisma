// ELSAAD — Phase 2 foundation schema.
// Phase 2 decisions applied:
//   1B — superseded by Sprint 2D: User model added below; ADMIN_API_KEY kept
//        as a dual-auth alternative to JWT (AdminAuthGuard accepts either)
//   2C — guest checkout: customerId nullable, phone required via Customer
//   3C — soft delete (deletedAt) on Product + Order only
//   4B — prices exclusive of VAT: Product.taxRate default 0.14, Order.taxAmount stored
//   5A — StockMovement retained (Phase 2A) although later brief deferred it to
//        Phase 3 — FLAGGED for review, zero runtime impact (no UI/service uses it).
// FLAG: old draft Product/Branch/Order/OrderItem replaced by Phase 2 definitions
//       (no DATABASE_URL was ever provisioned, so no data exists to migrate).
// FLAG: Category.products back-relation removed (old draft coupling) — Category
//       remains a pure landing-page display model per brief.
// Do NOT run `npx prisma migrate` until a DATABASE_URL is provisioned.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Contact form persistence (Phase 2A) ----------

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  message   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------- Landing-page display content (kept as-is) ----------

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  text      String
  rating    Int      @default(5)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------- Stock audit trail ----------

// ---------- Part catalog: brands / models / categories / suppliers ----------

model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  nameAr      String?
  slug        String   @unique
  logoUrl     String?
  website     String?
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  models   MachineModel[]
  products Product[]
}

model MachineModel {
  id          String   @id @default(cuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String
  nameAr      String?
  slug        String
  category    String   @default("دراجات نارية")
  yearFrom    Int?
  yearTo      Int?
  engineCc    Int?
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())

  compatibilities ProductCompatibility[]

  @@unique([brandId, slug])
  @@index([brandId])
  @@index([category])
}

model PartCategory {
  id        String         @id @default(cuid())
  name      String
  nameAr    String?
  slug      String         @unique
  parentId  String?
  parent    PartCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  PartCategory[] @relation("CategoryTree")
  order     Int            @default(0)
  createdAt DateTime       @default(now())

  products Product[]

  @@index([parentId])
}

model Supplier {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  nameAr       String?
  nameEn       String?
  phone        String?
  email        String?
  address      String?
  country      String?  @default("Taiwan")
  leadTimeDays Int      @default(7)
  note         String?
  createdAt    DateTime @default(now())

  products       Product[]
  purchaseOrders PurchaseOrder[]
}

// ---------- Products ----------

model Product {
  id              String        @id @default(cuid())
  code            String        @unique
  name            String
  nameEn          String?
  description     String?
  oemCode         String?
  partCategoryId  String?
  partCategory    PartCategory? @relation(fields: [partCategoryId], references: [id])
  brandId         String?
  brand           Brand?        @relation(fields: [brandId], references: [id])
  supplierId      String?
  supplier        Supplier?     @relation(fields: [supplierId], references: [id])
  costPrice       Decimal?      @db.Decimal(10, 2)
  wholesalePrice  Decimal?      @db.Decimal(10, 2)
  retailPrice     Decimal?      @db.Decimal(10, 2)
  vipPrice        Decimal?      @db.Decimal(10, 2)
  taxRate         Decimal       @default(0.14) @db.Decimal(5, 4)
  unitOfMeasure   String        @default("قطعة")
  reorderLevel    Int           @default(5)
  tags            String[]      @default([])
  // Store catalog type: new | used | spare-parts | accessories
  type            String        @default("spare-parts")
  isFeatured      Boolean       @default(false)
  onSale          Boolean       @default(false)
  discountPercent Decimal?      @db.Decimal(5, 2)
  active          Boolean       @default(true)
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  images             ProductImage[]
  compatibilities    ProductCompatibility[]
  inventory          BranchInventory[]
  orderItems         OrderItem[]
  cartItems          CartItem[]
  movements          StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([partCategoryId])
  @@index([brandId])
  @@index([active])
  @@index([type])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  order     Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([productId])
}

model ProductCompatibility {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  modelId   String
  model     MachineModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  note      String?

  @@unique([productId, modelId])
  @@index([modelId])
}

// ---------- Branches / employees / inventory ----------

model Branch {
  id           String    @id @default(cuid())
  code         String    @unique
  slug         String    @unique
  nameAr       String
  nameEn       String?
  type         String    @default("retail")
  phone        String?
  whatsapp     String?
  address      String
  addressEn    String?
  governorate  String
  latitude     Float?
  longitude    Float?
  openingHours Json?
  managerId    String?
  manager      Employee? @relation("BranchManager", fields: [managerId], references: [id])
  active       Boolean   @default(true)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employees      Employee[]
  assignments    EmployeeBranchAssignment[]
  inventory      BranchInventory[]
  orders         Order[]
  purchaseOrders PurchaseOrder[]
  stockMovements StockMovement[]

  @@index([governorate])
  @@index([active])
}

model Employee {
  id             String   @id @default(cuid())
  employeeNumber String   @unique
  nameAr         String
  nameEn         String?
  nationalId     String?  @unique
  phone          String
  email          String?
  role           String   @default("cashier")
  branchId       String?
  branch         Branch?  @relation(fields: [branchId], references: [id])
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  managedBranches   Branch[]                   @relation("BranchManager")
  branchAssignments EmployeeBranchAssignment[]
  orders            Order[]
  user              User?

  @@index([role])
}

model EmployeeBranchAssignment {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())
  isActive   Boolean  @default(true)

  @@unique([employeeId, branchId])
  @@index([branchId])
}

model BranchInventory {
  id           String   @id @default(cuid())
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity     Int      @default(0)
  reorderLevel Int?
  updatedAt    DateTime @updatedAt

  @@unique([branchId, productId])
  @@index([productId])
}

// ---------- Documents (Phase 8 — storage-backed attachments) ----------
// FLAG: real WORM enforcement (COMPLIANCE retention) requires STORAGE_DRIVER=
// minio — the local driver records immutable/retainedUntil in the DB only and
// its setRetention() is a no-op (TODO: enforce on disk or require minio).

enum DocumentEntityType {
  PRODUCT
  CATEGORY
  BRAND
  MODEL
  SUPPLIER
  BRANCH
  EMPLOYEE
  ORDER
  CUSTOMER
}

enum DocumentStatus {
  ACTIVE
  DELETED
}

model Document {
  id            String             @id @default(cuid())
  entityType    DocumentEntityType
  entityId      String
  fileName      String // sanitized unique-on-disk name
  originalName  String // client's filename (display)
  mimeType      String
  size          Int
  checksum      String // sha256 hex of the bytes
  storageKey    String             @unique
  storageDriver String // "minio" | "local" — snapshot at upload time
  uploadedById  String? // no FK yet: auth arrives after Decision 1B
  immutable     Boolean            @default(false)
  retainedUntil DateTime?
  status        DocumentStatus     @default(ACTIVE)
  deletedAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([entityType, entityId])
  @@index([status])
}

// ---------- Customers / orders ----------

model Customer {
  id                   String    @id @default(cuid())
  code                 String    @unique
  name                 String
  phone                String    @unique
  phone2               String?
  email                String?   @unique
  type                 String    @default("retail")
  // B2C auth: "retail" | "wholesale" (the legacy `type` column stays untouched)
  customerType         String    @default("retail")
  // Wholesale approval workflow: "pending" | "approved" | "rejected"
  approvalStatus       String    @default("approved")
  passwordHash         String?
  businessName         String? // B2B only
  commercialRegister   String? // B2B only (taxNumber column above already existed)
  emailVerified        Boolean   @default(false)
  phoneVerified        Boolean   @default(false)
  googleId             String?   @unique
  avatarUrl            String?
  successfulDeliveries Int       @default(0)
  failedDeliveries     Int       @default(0)
  blockedAt            DateTime?
  blockedReason        String?
  lastOrderAt          DateTime?
  address              String?
  governorate          String?
  taxNumber            String?
  creditLimit          Decimal?  @db.Decimal(10, 2)
  notes                String?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  orders Order[]

  cart Cart[]

  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]

  @@index([approvalStatus])
}

model PasswordReset {
  id         String    @id @default(cuid())
  token      String    @unique
  customer   Customer  @relation(fields: [customerId], references: [id])
  customerId String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([token])
  @@index([customerId])
  @@index([expiresAt])
}

model Order {
  id                  String    @id @default(cuid())
  orderNumber         String    @unique
  customerId          String?
  customer            Customer? @relation(fields: [customerId], references: [id])
  branchId            String?
  branch              Branch?   @relation(fields: [branchId], references: [id])
  employeeId          String?
  employee            Employee? @relation(fields: [employeeId], references: [id])
  status              String    @default("pending")
  subtotal            Decimal   @default(0) @db.Decimal(10, 2)
  taxAmount           Decimal   @default(0) @db.Decimal(10, 2)
  discount            Decimal   @default(0) @db.Decimal(10, 2)
  total               Decimal   @db.Decimal(10, 2)
  paymentMethod       String    @default("cod")
  paymentStatus       String    @default("pending")
  paymentReference    String?
  paymentReference2   String?
  paidAt              DateTime?
  shippingCost        Decimal   @default(0) @db.Decimal(10, 2)
  shippingMethod      String    @default("standard")
  notes               String?
  shippingAddress     String?
  shippingCity        String?
  shippingGovernorate String?
  shippingPhone       String?
  codLimitAtPurchase  Decimal?  @db.Decimal(10, 2)
  riskScore           Int       @default(0)
  riskLevel           String    @default("low")
  riskBreakdown       Json?
  ipAddress           String?
  userAgentHash       String?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  items               OrderItem[]
  paymentTransactions PaymentTransaction[]

  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  discount  Decimal @default(0) @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2)
  note      String?

  @@index([orderId])
  @@index([productId])
}

model Cart {
  id         String     @id @default(cuid())
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id])
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([customerId])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model PurchaseOrder {
  id                   String    @id @default(cuid())
  orderNumber          String    @unique // PO-YYYY-NNNNN
  supplierId           String
  supplier             Supplier  @relation(fields: [supplierId], references: [id])
  branchId             String
  branch               Branch    @relation(fields: [branchId], references: [id])
  status               String    @default("draft") // draft, ordered, shipped, received, cancelled
  subtotal             Decimal   @db.Decimal(10, 2)
  taxAmount            Decimal   @default(0) @db.Decimal(10, 2)
  shippingCost         Decimal   @default(0) @db.Decimal(10, 2)
  customsCost          Decimal   @default(0) @db.Decimal(10, 2)
  total                Decimal   @db.Decimal(10, 2)
  notes                String?
  expectedDeliveryDate DateTime?
  receivedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  items          PurchaseOrderItem[]
  stockMovements StockMovement[]

  @@index([supplierId])
  @@index([branchId])
  @@index([status])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  unitCost        Decimal       @db.Decimal(10, 2)
  lineTotal       Decimal       @db.Decimal(10, 2)

  @@index([purchaseOrderId])
  @@index([productId])
}

model StockMovement {
  id              String         @id @default(cuid())
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  branchId        String
  branch          Branch         @relation(fields: [branchId], references: [id])
  type            String // purchase, sale, transfer_in, transfer_out, adjustment, return
  quantityDelta   Int // positive for in, negative for out
  referenceId     String? // PO id, Order id, or Transfer id
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  notes           String?
  createdAt       DateTime       @default(now())

  @@index([productId])
  @@index([branchId])
  @@index([type])
  @@index([createdAt])
}

// ---------- Auth (Sprint 2D — JWT RS256 + refresh rotation) ----------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String // scrypt: N:saltB64:hashB64
  role         String    @default("admin") // "admin" | "manager"
  employeeId   String?   @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens RefreshToken[]

  @@index([role])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId String? // customer sessions (B2C auth) — admin sessions keep userId
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  familyId   String // rotation family — reuse of a revoked token revokes the family
  tokenHash  String    @unique // sha256 of the opaque token; raw token never stored
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([customerId])
  @@index([familyId])
}

// Sprint 3 — Financial Intelligence: singleton row (id always "singleton")
model CompanySettings {
  id                    String   @id @default("singleton")
  // Monthly fixed costs (in EGP)
  monthlyRent           Decimal  @default(0) @db.Decimal(10, 2)
  monthlySalaries       Decimal  @default(0) @db.Decimal(10, 2)
  monthlyUtilities      Decimal  @default(0) @db.Decimal(10, 2)
  monthlyMarketing      Decimal  @default(0) @db.Decimal(10, 2)
  monthlyOther          Decimal  @default(0) @db.Decimal(10, 2)
  // Break-even target
  vatRate               Decimal  @default(0.14) @db.Decimal(5, 4) // 14% VAT (Egypt)
  // Shipping & Payment settings
  shippingEnabled       Boolean  @default(true)
  codEnabled            Boolean  @default(true)
  paymobEnabled         Boolean  @default(false)
  fawryEnabled          Boolean  @default(false)
  instapayEnabled       Boolean  @default(false)
  defaultStandardFee    Decimal  @default(50) @db.Decimal(10, 2)
  defaultExpressFee     Decimal  @default(100) @db.Decimal(10, 2)
  defaultFreeOverAmount Decimal? @db.Decimal(10, 2)
  defaultCodFee         Decimal  @default(0) @db.Decimal(10, 2)
  // Timestamps
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())
}

model ShippingRate {
  id             String   @id @default(cuid())
  governorate    String
  city           String?
  standardFee    Decimal  @db.Decimal(10, 2)
  expressFee     Decimal? @db.Decimal(10, 2)
  freeOverAmount Decimal? @db.Decimal(10, 2)
  codFee         Decimal  @default(0) @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([governorate, city])
  @@index([governorate])
}

model PaymentTransaction {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id])
  provider     String
  providerRef  String?
  amount       Decimal  @db.Decimal(10, 2)
  currency     String   @default("EGP")
  status       String
  method       String?
  rawPayload   Json?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orderId])
  @@index([provider, providerRef])
  @@index([status])
  @@index([createdAt])
}
